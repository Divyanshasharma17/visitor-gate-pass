FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/visitor_gate_pass
TEST_DATABASE_URL=sqlite:///:memory:
# Optional SMTP (leave MAIL_SERVER empty to disable email)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=gatepass@example.com
RATELIMIT_STORAGE_URI=memory://
